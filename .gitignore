# --- Data -------------------------------------------------------------------
# Raw downloads are re-created by scripts/01_download_data.py and verified
# against the checksums in metadata/data_provenance.json.
data/raw/*
!data/raw/README.md
# Processed matrices are regenerated by scripts/04_preprocess_counts.py.
data/processed/*
!data/processed/README.md
# Never commit sequencing reads or alignment files.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.bam
*.bai
*.sam
*.h5ad
*.part

# --- Python / environments --------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- R ----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# --- Credentials and local config -------------------------------------------
.env
.env.*
*.pem
*.key
credentials*.json
token*.txt

# --- OS / editor clutter ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.tmp
~$*
