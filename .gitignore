# --- Data -------------------------------------------------------------------
# Raw downloads are re-created by scripts/01_download_data.py and verified
# against the checksums in metadata/data_provenance.json.
data/raw/*
!data/raw/README.md
# Processed matrices are regenerated by scripts/04_preprocess_counts.py.
data/processed/*
!data/processed/README.md
# Never commit sequencing reads or alignment files.
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.bam
*.bai
*.sam
*.h5ad
*.part

# --- Python / environments --------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- R ----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# --- Credentials and local config -------------------------------------------
.env
.env.*
*.pem
*.key
credentials*.json
token*.txt

# --- OS / editor clutter ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.tmp
~$*

# --- Phase 2 model outputs (regenerated by the analysis scripts) -------------
# Fitted objects and VST matrices are large and fully reproducible.
results/deseq2/**/dds.rds
results/deseq2/**/vst_matrix.csv.gz
# Per-gene tables are kept for the primary and muscle-covariate fits only;
# sensitivity/leave-one-out variants keep their summaries.
results/deseq2/loo/**/results_*.csv.gz
results/deseq2/*__drop_*/results_*.csv.gz
results/deseq2/*__cov_depth/results_*.csv.gz
results/deseq2/*__cov_quality_proxy/results_*.csv.gz
results/deseq2/*__cov_clock_phase/results_*.csv.gz
results/pathways/loo/**/fgsea_results.csv.gz
figures/deseq2/loo/
figures/deseq2/*__*/
!figures/deseq2/*__cov_muscle/
